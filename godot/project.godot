; Klippy-Cat — desktop pixel pet. Layers 1 (brain) + 2 (rendering).
; The window is the cat: a small transparent always-on-top surface that is repositioned
; as the cat moves. Idle cost is engineered, not assumed (see §5 / spike docs).

config_version=5

[application]

config/name="Klippy-Cat"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")
; On-demand rendering: the engine sleeps between iterations; a static cat draws no frames.
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=16000

[display]

window/size/viewport_width=256
window/size/viewport_height=256
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=true
window/per_pixel_transparency/allowed=true

[rendering]

; lighter than Forward+ for a 2D pet; revisit if effects need it
renderer/rendering_method="gl_compatibility"
